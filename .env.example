# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection (Use MONGODB_URI on Render or MONGO_URI)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/clicktopya?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/clicktopya?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# Persistent Cloud Image Storage - Cloudinary (Free tier: 25GB storage & bandwidth)
# Get from: https://cloudinary.com/console
# Render Free filesystem is ephemeral; setting these ensures uploaded images never disappear!
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Store Owner / Admin WhatsApp (Used for server-side order notifications)
ADMIN_WHATSAPP_NUMBER=201011643099

# Meta WhatsApp Cloud API (Optional - for automated server messages to admin)
# WHATSAPP_API_TOKEN=your_meta_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
